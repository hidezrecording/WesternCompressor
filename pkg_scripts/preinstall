#!/bin/bash
# Hotdog installer preinstall: wipe all previous versions

# System library
rm -rf "/Library/Audio/Plug-Ins/VST3/Hotdog.vst3"
rm -rf "/Library/Audio/Plug-Ins/Components/Hotdog.component"
rm -rf "/Applications/Hotdog.app"

# User library (for each user - $HOME is the installing user)
rm -rf "$HOME/Library/Audio/Plug-Ins/VST3/Hotdog.vst3"
rm -rf "$HOME/Library/Audio/Plug-Ins/Components/Hotdog.component"

# Clear AU cache to force rescan
rm -rf "$HOME/Library/Caches/com.apple.audiounits.cache"
killall -9 AudioComponentRegistrar 2>/dev/null || true

exit 0
